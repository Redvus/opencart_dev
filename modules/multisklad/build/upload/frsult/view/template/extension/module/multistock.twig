{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
                    <i class="fa fa-save"></i>
                </button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger alert-dismissible">
                <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}

        {% if success %}
            <div class="alert alert-success alert-dismissible">
                <i class="fa fa-check-circle"></i> {{ success }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-puzzle-piece"></i> {{ heading_title }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                            {% if error_name %}
                                <div class="text-danger">{{ error_name }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                        <div class="col-sm-10">
                            <select name="status" id="input-status" class="form-control">
                                <option value="1" {{ status == 1 ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
                                <option value="0" {{ status == 0 ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label">{{ entry_storages }}</label>
                        <div class="col-sm-10">
                            <div id="storages-table-container" class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <td class="text-left">ID</td>
                                            <td class="text-left">{{ entry_warehouse_name }}</td>
                                            <td class="text-left">{{ entry_nick }}</td>
                                            <td class="text-left">{{ entry_desc }}</td>
                                            <td class="text-left">{{ entry_delete }}</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if storages %}
                                            {% for storage in storages %}
                                                <tr>
                                                    <td>{{ storage.id_storage }}</td>
                                                    <td>{{ storage.name_storage }}</td>
                                                    <td><input type="text" name="store[{{ storage.id_storage }}][nick]" value="{{ storage.nick }}" class="form-control"></td>
                                                    <td><input type="text" name="store[{{ storage.id_storage }}][desc]" value="{{ storage.desc_storage }}" class="form-control"></td>
                                                    <td><input type="checkbox" name="delete_ids[]" value="{{ storage.id_storage }}"></td>
                                                </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center">{{ text_no_storages }}</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                            <button type="button" id="btn_delete_storage" class="btn btn-danger">{{ button_delete_storage }}</button>
                            <button type="button" id="btn_create_tables" class="btn btn-info">{{ button_create_tables }}</button>
                            <button type="button" id="btn_update_storages" class="btn btn-primary">Сохранить изменения</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label">{{ button_add_storage }}</label>
                        <div class="col-sm-10">
                            <div class="row">
                                <div class="col-sm-4">
                                    <input type="text" name="storage_name" id="storage_name" class="form-control" placeholder="{{ entry_warehouse_name }}">
                                </div>
                                <div class="col-sm-3">
                                    <input type="text" name="storage_nick" id="storage_nick" class="form-control" placeholder="{{ entry_nick }}">
                                </div>
                                <div class="col-sm-3">
                                    <input type="text" name="storage_desc" id="storage_desc" class="form-control" placeholder="{{ entry_desc }}">
                                </div>
                                <div class="col-sm-2">
                                    <button type="button" id="btn_add_storage" class="btn btn-success">{{ button_add_storage }}</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="user_token" value="{{ user_token }}">
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    var user_token = '{{ user_token }}';

    // Добавление склада через AJAX
    $('#btn_add_storage').on('click', function() {
        var name = $('#storage_name').val();
        var nick = $('#storage_nick').val();
        var desc = $('#storage_desc').val();

        if (name == '') {
            alert('Введите название склада');
            return;
        }

        $.ajax({
            url: 'index.php?route=extension/module/multistock/addStorageAjax&user_token=' + user_token,
            type: 'post',
            data: {
                name: name,
                nick: nick,
                desc: desc
            },
            dataType: 'json',
            beforeSend: function() {
                $('#btn_add_storage').text('Добавление...').prop('disabled', true);
            },
            success: function(json) {
                if (json.error) {
                    alert(json.error);
                } else if (json.success) {
                    $('#storage_name').val('');
                    $('#storage_nick').val('');
                    $('#storage_desc').val('');
                    loadStoragesTable();
                }
            },
            complete: function() {
                $('#btn_add_storage').text('Добавить склад').prop('disabled', false);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Ошибка: ' + thrownError);
                console.log(xhr.responseText);
            }
        });
    });

    // Удаление выбранных складов
    $('#btn_delete_storage').on('click', function() {
        var selected = [];
        $('input[name="delete_ids[]"]:checked').each(function() {
            selected.push($(this).val());
        });

        if (selected.length == 0) {
            alert('Выберите склады для удаления');
            return;
        }

        if (confirm('Удалить выбранные склады? Данные об остатках будут также удалены.')) {
            $.ajax({
                url: 'index.php?route=extension/module/multistock/deleteStorageAjax&user_token=' + user_token,
                type: 'post',
                data: {
                    delete_ids: selected
                },
                dataType: 'json',
                beforeSend: function() {
                    $('#btn_delete_storage').text('Удаление...').prop('disabled', true);
                },
                success: function(json) {
                    if (json.success) {
                        loadStoragesTable();
                    }
                },
                complete: function() {
                    $('#btn_delete_storage').text('Удалить отмеченные').prop('disabled', false);
                }
            });
        }
    });

    // Создание таблиц
    $('#btn_create_tables').on('click', function() {
        if (confirm('Создать таблицы складов и остатков?')) {
            $.ajax({
                url: 'index.php?route=extension/module/multistock/createTablesAjax&user_token=' + user_token,
                type: 'post',
                dataType: 'json',
                beforeSend: function() {
                    $('#btn_create_tables').text('Создание...').prop('disabled', true);
                },
                success: function(json) {
                    if (json.success) {
                        loadStoragesTable();
                    } else if (json.error) {
                        alert(json.error);
                    }
                },
                complete: function() {
                    $('#btn_create_tables').text('Создать таблицы').prop('disabled', false);
                }
            });
        }
    });

    // Функция загрузки таблицы складов
    function loadStoragesTable() {
        $.ajax({
            url: 'index.php?route=extension/module/multistock/getStoragesTable&user_token=' + user_token,
            type: 'get',
            dataType: 'html',
            success: function(html) {
                $('#storages-table-container').html(html);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log('Ошибка загрузки таблицы: ' + thrownError);
            }
        });
    }

    // Сохранение полей складов через AJAX
    $('#btn_update_storages').on('click', function() {
        var storeData = {};

        // Собираем данные из таблицы
        $('input[name^="store["]').each(function() {
            var name = $(this).attr('name');
            var match = name.match(/store\[(\d+)\]\[(nick|desc)\]/);
            if (match) {
                var storage_id = match[1];
                var field = match[2];
                if (!storeData[storage_id]) {
                    storeData[storage_id] = {};
                }
                storeData[storage_id][field] = $(this).val();
            }
        });

        $.ajax({
            url: 'index.php?route=extension/module/multistock/updateStoragesAjax&user_token={{ user_token }}',
            type: 'post',
            data: {
                store: storeData
            },
            dataType: 'json',
            beforeSend: function() {
                $('#btn_update_storages').text('Сохранение...').prop('disabled', true);
            },
            success: function(json) {
                if (json.success) {
                    $('#btn_update_storages').text('Сохранено!');
                    setTimeout(function() {
                        $('#btn_update_storages').text('Сохранить изменения').prop('disabled', false);
                    }, 1000);
                } else if (json.error) {
                    alert(json.error);
                    $('#btn_update_storages').text('Сохранить изменения').prop('disabled', false);
                }
            },
            error: function() {
                alert('Ошибка сохранения');
                $('#btn_update_storages').text('Сохранить изменения').prop('disabled', false);
            }
        });
    });
});
</script>

{{ footer }}